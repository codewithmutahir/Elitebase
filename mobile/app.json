{
  "expo": {
    "name": "Elitebase Kiosk",
    "slug": "elitebase-kiosk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "scheme": "elitebase-kiosk",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/68679bef-3776-45ec-9319-f71d923bee79",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "androidNavigationBar": {
      "visible": "immersive"
    },
    "androidStatusBar": {
      "hidden": true,
      "translucent": true
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "Used for face verification during clock-in and clock-out."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.elitebase.kiosk",
      "infoPlist": {
        "NSCameraUsageDescription": "Used for face verification during clock-in and clock-out.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#2563eb"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.elitebase.kiosk"
    },
    "extra": {
      "eas": {
        "projectId": "68679bef-3776-45ec-9319-f71d923bee79"
      }
    }
  }
}
